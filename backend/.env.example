# Reference for the variables the app needs. Where they actually go depends
# on how you're running it:
#
# - Dokploy / docker compose: set these in Dokploy's Environment Variables
#   panel (or a root-level .env next to docker-compose.yml). DATABASE_URL is
#   built automatically from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB —
#   don't set it directly there.
# - Running the backend directly (no Docker): copy this file to backend/.env
#   and fill in every value, including DATABASE_URL.
#
# Never commit a real .env to version control.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=finance_tracker

# Only used when running the backend directly, without Docker.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/finance_tracker

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins, e.g. https://nairaai.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

VITE_API_URL=http://localhost:8000

# Set True in production so cookies are only sent over HTTPS.
COOKIE_SECURE=False

# development or production
ENVIRONMENT=development
